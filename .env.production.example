# Configure these as Production variables in Vercel Project Settings.
# Provision a Supabase Postgres project in Singapore, enable pgvector, and use its pooler URL.
# Vercel Queues supplies CELERY_BROKER_URL to the Celery subscriber; no Redis URL is needed.

APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
JWT_SECRET_KEY=<generate-a-unique-secret-with-at-least-32-characters>
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_INIT_ON_STARTUP=false

ADMIN_EMAIL=<real-admin-email>
ADMIN_PASSWORD=<unique-password-at-least-16-characters>
SEED_DEMO_USERS=false
SEED_SYNTHETIC_DATA=false

LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
ENABLE_RECOMMENDATIONS=false
ENABLE_CHATBOT=false
ENABLE_RAG=false
ENABLE_EHR_SUMMARY=false
ENABLE_PERSONALIZED_PLANS=false
ENABLE_FORECASTING=false
ENABLE_NATIONAL_ANALYTICS=false
ENABLE_POPULATION_FORECASTING=false
ENABLE_PATTERN_DISCOVERY=false
ENABLE_NATIONAL_INDIVIDUAL_PREDICTOR=false

# Next.js Production variable (set during the Vercel build)
NEXT_PUBLIC_DEMO_MODE=false
